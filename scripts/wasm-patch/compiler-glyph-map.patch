+    /// Glyph map for in-preview editing (iota4web patch): a flat f64 array,
+    /// 10 numbers per glyph — page, x, y, w, h, byte_start, byte_end, kind,
+    /// first code point of the glyph's text, number of chars it covers
+    /// (0 for a glyph the shaper inserted, e.g. a hyphen). The last two let
+    /// the JS side align glyphs with the original text when spans are
+    /// unreliable (regex show rules re-slice text elements).
+    /// kind: 1 = text / math text (glyph-precise offsets), 2 = string literal
+    /// (offset inside the literal, approximate when it has escapes),
+    /// 0 = anything else (offsets are the node's range), 4 = a glyph inside a
+    /// heading of the main file that carries no main-file span itself (the
+    /// template re-typesets chapter titles; offsets are the heading node's
+    /// range, the JS side aligns the glyph text), 3 = an echo of the
+    /// source that is not the place to edit it (outline entries, running
+    /// headers / footers in the page margins). Only glyphs whose span lives
+    /// in the main file are listed; coordinates are page pt.
+    pub fn glyph_map(&mut self) -> Result<JsValue, JsValue> {
+        use ::typst::introspection::Tag;
+        use ::typst::layout::{Frame, FrameItem, Point, Transform};
+        use ::typst::syntax::{Source, SyntaxKind};
+        use ::typst::World;
+
+        let Some(doc) = self.do_compile_paged()? else {
+            return Ok(JsValue::NULL);
+        };
+        let world = self.graph.world();
+        let main = world.main();
+        let source: Source = world.source(main).map_err(|e| format!("{e:?}"))?;
+
+        /// Where the piece of a text element that is currently being laid out
+        /// starts in the source. A `show regex` rule splits a text element into
+        /// pieces that all keep the element's span, with glyph offsets that
+        /// restart at 0 in every piece; pieces partition the element's text in
+        /// order, so a restart means the next piece starts where the previous
+        /// glyph ended (skipping a space the line breaker trimmed).
+        struct Piece {
+            /// Absolute byte offset in the source where the current piece starts
+            base: usize,
+            last_off: usize,
+            last_rel_end: usize,
+            last_text: String,
+            /// Absolute byte offset right after the last glyph seen
+            last_abs_end: usize,
+        }
+
+        struct Walk<'a> {
+            source: &'a Source,
+            out: Vec<f64>,
+            /// Open introspection tags: (location, is an outline entry, range of a
+            /// heading in the main file whose text the template re-typesets)
+            tags: Vec<(::typst::introspection::Location, bool, Option<std::ops::Range<usize>>)>,
+            page_h: f64,
+            pieces: std::collections::HashMap<::typst::syntax::Span, Piece>,
+            /// Inside a page-level group that is not the body (header / footer / background)
+            in_margin_group: bool,
+        }
+
+        /// Absolute source range of a text glyph, piece-aware (see `Piece`).
+        fn text_range(
+            wk: &mut Walk,
+            span: ::typst::syntax::Span,
+            r: std::ops::Range<usize>,
+            off: usize,
+            len: usize,
+            gtext: &str,
+            echo: bool,
+        ) -> (usize, usize) {
+            let plain = || {
+                let s = (r.start + off).min(r.end);
+                (s, (s + len).min(r.end))
+            };
+            // Echoes (outline entries, running headers) repeat text laid out elsewhere:
+            // they must not disturb the piece tracking of the real thing.
+            if echo {
+                return plain();
+            }
+            let rel_end = off + len;
+            let st = wk.pieces.entry(span).or_insert(Piece {
+                base: r.start,
+                last_off: usize::MAX,
+                last_rel_end: 0,
+                last_text: String::new(),
+                last_abs_end: r.start,
+            });
+            let first = st.last_off == usize::MAX;
+            let restart = !first
+                && (off < st.last_off
+                    || (off == st.last_off
+                        && (rel_end != st.last_rel_end || gtext != st.last_text)));
+            if restart {
+                // Next piece starts where the previous glyph ended; a trimmed space or
+                // an escape may sit in between, so look a few bytes ahead for the glyph.
+                let src = wk.source.text();
+                let mut b = st.last_abs_end;
+                let mut found = None;
+                if !gtext.is_empty() && b <= src.len() && src.is_char_boundary(b) {
+                    for (i, _) in src[b..].char_indices().take(4) {
+                        if src[b + i..].starts_with(gtext) {
+                            found = Some(b + i);
+                            break;
+                        }
+                    }
+                }
+                if let Some(f) = found {
+                    b = f.saturating_sub(off);
+                }
+                if b >= r.start && b + rel_end <= r.end {
+                    st.base = b;
+                } else {
+                    st.base = r.start;
+                }
+            }
+            let s = (st.base + off).min(r.end);
+            let e = (s + len).min(r.end);
+            st.last_off = off;
+            st.last_rel_end = rel_end;
+            st.last_text = gtext.to_string();
+            st.last_abs_end = e;
+            (s, e)
+        }
+
+        /// First span inside `c` that lives in the given file (walking sequences and styled wrappers).
+        fn main_span(c: &::typst::foundations::Content, id: ::typst::syntax::FileId) -> Option<::typst::syntax::Span> {
+            if c.span().id() == Some(id) {
+                return Some(c.span());
+            }
+            if let Some(seq) = c.to_packed::<::typst::foundations::SequenceElem>() {
+                for ch in seq.children.iter() {
+                    if let Some(s) = main_span(ch, id) {
+                        return Some(s);
+                    }
+                }
+            }
+            if let Some(st) = c.to_packed::<::typst::foundations::StyledElem>() {
+                return main_span(&st.child, id);
+            }
+            None
+        }
+
+        fn walk(wk: &mut Walk, frame: &Frame, ts: Transform, page: usize) {
+            let source = wk.source;
+            for (pos, item) in frame.items() {
+                match item {
+                    FrameItem::Tag(tag) => match tag {
+                        Tag::Start(elem, _) => {
+                            if let Some(loc) = elem.location() {
+                                let name = elem.func().name();
+                                // A heading written in the main file: glyphs inside it that carry
+                                // no main-file span (the template rebuilds chapter titles from
+                                // strings) are reported against the heading itself (kind 4).
+                                // The heading may be created by a template function
+                                // (#chapter(..)[body]); then its own span is in the template and
+                                // the first main-file span inside its body names the place.
+                                // Any element written in the main file (a #mitex(..) call, a
+                                // #footnote, a heading): template-made glyphs inside it that have
+                                // no main-file span are reported against it (kind 4).
+                                let id = wk.source.id();
+                                let sp = if elem.span().id() == Some(id) {
+                                    Some(elem.span())
+                                } else if name == "heading" {
+                                    elem.to_packed::<::typst::model::HeadingElem>()
+                                        .and_then(|h| main_span(&h.body, id))
+                                } else {
+                                    None
+                                };
+                                let hr = sp.and_then(|s| wk.source.find(s)).map(|n| n.range());
+                                wk.tags.push((loc, name == "entry", hr));
+                            }
+                        }
+                        Tag::End(loc, _, _) => {
+                            if let Some(i) = wk.tags.iter().rposition(|(l, _, _)| l == loc) {
+                                wk.tags.truncate(i);
+                            }
+                        }
+                    },
+                    FrameItem::Group(g) => {
+                        let t = ts
+                            .pre_concat(Transform::translate(pos.x, pos.y))
+                            .pre_concat(g.transform);
+                        walk(wk, &g.frame, t, page);
+                    }
+                    FrameItem::Text(text) => {
+                        let in_entry = wk.tags.iter().any(|(_, e, _)| *e);
+                        let heading = wk.tags.iter().rev().find_map(|(_, _, h)| h.clone());
+                        let mut x = pos.x;
+                        for glyph in &text.glyphs {
+                            let w = glyph.x_advance.at(text.size);
+                            let (span, off) = glyph.span;
+                            if span.id() != Some(source.id()) && !in_entry {
+                                if let Some(hr) = &heading {
+                                    let gtext = text.text.get(glyph.range()).unwrap_or("");
+                                    let cp = gtext.chars().next().map(|c| c as u32).unwrap_or(0);
+                                    let nchars = gtext.chars().count();
+                                    let fm = text.font.metrics();
+                                    let asc = fm.ascender.at(text.size);
+                                    let desc = fm.descender.at(text.size);
+                                    let p1 = Point::new(x, pos.y - asc).transform(ts);
+                                    let p2 = Point::new(x + w, pos.y - desc).transform(ts);
+                                    let (x1, y1) = (p1.x.to_pt(), p1.y.to_pt());
+                                    let (x2, y2) = (p2.x.to_pt(), p2.y.to_pt());
+                                    let top = y1.min(y2);
+                                    let bottom = y1.max(y2);
+                                    let in_margin = wk.in_margin_group || bottom < wk.page_h * 0.085 || top > wk.page_h * 0.93;
+                                    let kind = if in_margin { 3.0 } else { 4.0 };
+                                    wk.out.extend_from_slice(&[
+                                        page as f64, x1.min(x2), top, (x2 - x1).abs(), bottom - top,
+                                        hr.start as f64, hr.end as f64, kind, cp as f64, nchars as f64,
+                                    ]);
+                                }
+                            }
+                            if span.id() == Some(source.id()) {
+                                if let Some(node) = source.find(span) {
+                                    let r = node.range();
+                                    let len = glyph.range().len();
+                                    // Box from ascender to descender, like a caret in a word processor;
+                                    // pos.y is the baseline.
+                                    let fm = text.font.metrics();
+                                    let asc = fm.ascender.at(text.size);
+                                    let desc = fm.descender.at(text.size);
+                                    let p1 = Point::new(x, pos.y - asc).transform(ts);
+                                    let p2 = Point::new(x + w, pos.y - desc).transform(ts);
+                                    let (x1, y1) = (p1.x.to_pt(), p1.y.to_pt());
+                                    let (x2, y2) = (p2.x.to_pt(), p2.y.to_pt());
+                                    let top = y1.min(y2);
+                                    let bottom = y1.max(y2);
+                                    // Running headers / footers sit in the page margins: an echo, not the text itself.
+                                    let in_margin = wk.in_margin_group || bottom < wk.page_h * 0.085 || top > wk.page_h * 0.93;
+                                    let echo = in_entry || in_margin;
+                                    let gtext = text.text.get(glyph.range()).unwrap_or("");
+                                    let cp = gtext.chars().next().map(|c| c as u32).unwrap_or(0);
+                                    let nchars = gtext.chars().count();
+                                    let (start, end, kind): (usize, usize, f64) = match node.kind() {
+                                        SyntaxKind::Text | SyntaxKind::MathText => {
+                                            let (s, e) = text_range(wk, span, r.clone(), off as usize, len, gtext, echo);
+                                            (s, e, 1.0)
+                                        }
+                                        SyntaxKind::Str => {
+                                            let inner_end = r.end.saturating_sub(1).max(r.start);
+                                            let s = (r.start + 1 + off as usize).min(inner_end);
+                                            (s, (s + len).min(inner_end), 2.0)
+                                        }
+                                        _ => (r.start, r.end, 0.0),
+                                    };
+                                    let kind = if echo { 3.0 } else { kind };
+                                    wk.out.extend_from_slice(&[
+                                        page as f64,
+                                        x1.min(x2),
+                                        top,
+                                        (x2 - x1).abs(),
+                                        bottom - top,
+                                        start as f64,
+                                        end as f64,
+                                        kind,
+                                        cp as f64,
+                                        nchars as f64,
+                                    ]);
+                                }
+                            }
+                            x += w;
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+
+        let mut w = Walk { source: &source, out: Vec::new(), tags: Vec::new(), page_h: 842.0, pieces: Default::default(), in_margin_group: false };
+        for (i, page) in doc.pages().iter().enumerate() {
+            w.page_h = page.frame.size().y.to_pt();
+            w.tags.clear();
+            // The body is the tallest top-level group of the page; header, footer and
+            // background groups are echoes (running heads repeat chapter titles).
+            let body_h = page
+                .frame
+                .items()
+                .filter_map(|(_, it)| match it { FrameItem::Group(g) => Some(g.frame.size().y), _ => None })
+                .fold(::typst::layout::Abs::zero(), |a, b| if b > a { b } else { a });
+            for (pos, item) in page.frame.items() {
+                match item {
+                    FrameItem::Group(g) => {
+                        w.in_margin_group = g.frame.size().y < body_h;
+                        let t = Transform::translate(pos.x, pos.y).pre_concat(g.transform);
+                        walk(&mut w, &g.frame, t, i);
+                        w.in_margin_group = false;
+                    }
+                    _ => {}
+                }
+            }
+            // Loose items directly on the page frame (rare): walk them too
+            let mut loose = Frame::soft(page.frame.size());
+            for (pos, item) in page.frame.items() {
+                if !matches!(item, FrameItem::Group(_)) { loose.push(*pos, item.clone()); }
+            }
+            walk(&mut w, &loose, Transform::identity(), i);
+        }
+        Ok(js_sys::Float64Array::from(w.out.as_slice()).into())
+    }
+
     pub fn query(
         &mut self,
         kind: u8,
