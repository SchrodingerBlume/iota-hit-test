diff --git a/crates/typst-layout/src/inline/msword.rs b/crates/typst-layout/src/inline/msword.rs
new file mode 100644
index 000000000..b04faf55f
--- /dev/null
+++ b/crates/typst-layout/src/inline/msword.rs
@@ -0,0 +1,3398 @@
+// 本文件基于 Typst（typst/typst）与 typst-with-msword-linebreaks 修改（iota4web 合并到 Myriad-Dreamin/typst 之上，见 scripts/wasm-patch/typst-msword.patch）
+//! Line breaking that emulates Microsoft Word.
+//!
+//! Word fills a paragraph greedily, one line at a time: it puts as many
+//! characters on the line as fit, and when the next one does not, it first
+//! tries to squeeze it in by compressing the CJK punctuation already on the
+//! line. Closing punctuation may not start a line and opening punctuation may
+//! not end one; where Word cannot avoid that by compression, it lets the
+//! closing punctuation hang into the margin.
+//!
+//! The rules below were measured from Word itself (Word 16.89 for Mac): probe
+//! documents were generated for each compatibility mode, with and without a
+//! character grid, exported to PDF and read back glyph by glyph. hithesis'
+//! `hit-linebreak.lua`, which does the same for `LuaTeX`, was the starting
+//! point. Widths are taken from the shaped glyphs, so the fonts decide what
+//! is fullwidth punctuation: a curly quote is only treated as CJK
+//! punctuation when the font renders it fullwidth.
+//!
+//! Terminology: the *cell* of a character is its width on the page; with a
+//! character grid every CJK character occupies one grid cell, otherwise its
+//! natural advance. A *spot* is a punctuation mark whose blank half can be
+//! compressed. The *need* of a line is by how much it overflows the measure.
+//!
+//! Word 2013+ squeezes a *unit* (openers, a character or Latin run, and the
+//! closers after it) onto a justified line by a free-space rule, measured
+//! with indent sweeps: every spot before the unit (and the unit's own
+//! openers) gives up at most half a cell and at most the free space left
+//! before the unit, the last closer may hang a whole cell, and the automatic
+//! CJK-Latin spacings on the line lower the result a little. The older
+//! versions use half a cell per spot. See `tools/msword-probe/README.md`.
+
+use std::collections::HashMap;
+use typst_library::engine::Engine;
+use typst_library::layout::{Abs, Em};
+use typst_library::model::MswordLinebreaks;
+use typst_library::text::{Covers, TextElem, families};
+use unicode_script::{Script, UnicodeScript};
+use unicode_segmentation::UnicodeSegmentation;
+
+use super::linebreak::{Breakpoint, breakpoints};
+use super::shaping::Adjustability;
+use super::*;
+
+/// Full-width closing punctuation that may not start a line.
+const CLOSERS: &[char] = &[
+    '。', '，', '、', '；', '：', '？', '！', '）', '》', '〉', '”', '’', '」', '』',
+    '】', '］', '．', '｝', '〕', '〗', '〙', '〛',
+];
+
+/// Full-width opening punctuation that may not end a line.
+const OPENERS: &[char] =
+    &['（', '《', '〈', '「', '『', '【', '“', '‘', '［', '｛', '〔', '〖', '〘', '〚'];
+
+/// Closing punctuation that Word never compresses (measured: 0 of 68 cases).
+const NEVER_COMPRESSED: &[char] = &['？'];
+
+/// Full-width symbols that Word treats like Latin text: no automatic spacing
+/// around them.
+const LATINISH: &[char] = &['～', '—', '–', '·'];
+
+/// ASCII punctuation that may not start a line.
+const ASCII_CLOSE: &[char] = &['.', ',', ';', ':', '!', '?', ')', ']', '}', '%'];
+const ASCII_BRACKET_OPEN: &[char] = &['(', '[', '{'];
+/// Word's default Chinese kinsoku sets ("首尾字符设置"): characters that may
+/// not start a line and characters that may not end one, beyond the
+/// full-width punctuation handled as `Kind::Close` / `Kind::Open`.
+const NO_LINE_START: &[char] = &[
+    '!', '%', ')', ',', '.', ':', ';', '>', '?', ']', '}', '¢', '¨', '°', '·', 'ˇ', 'ˉ',
+    '―', '‖', '’', '”', '…', '‰', '′', '″', '›', '℃', '∶',
+];
+const NO_LINE_END: &[char] = &[
+    '$', '(', '[', '{', '£', '¥', '·', '‘', '“', '〈', '《', '「', '『', '【', '〔',
+    '〖', '〝',
+];
+const ASCII_BRACKET_CLOSE: &[char] = &[')', ']', '}'];
+/// East Asian dashes and the like that Word does not break away from
+/// Latin text before them (measured: never `a|—b`, `1|—b`, `a|…1` or
+/// `a|～b`, while `13—|93`, `a—|B`, `a—|α` and `α|—β` do break; full-width
+/// `－`, `＋`, `＝` break on both sides like any East Asian character).
+const CONNECTORS: &[char] = &['—', '–', '―', '…', '‖', '～'];
+
+/// ASCII punctuation that may not end a line.
+const ASCII_OPEN: &[char] = &['(', '[', '{'];
+
+/// Tolerance for width comparisons.
+const EPS: Abs = Abs::raw(0.03);
+
+/// By how much Word 2013+ lets a squeezed character's need exceed the
+/// free-space rule with `k` spots. Measured: about a fifth of a point with
+/// two spots, half of that with three, nothing from four on (a line with six
+/// spots was refused at 0.001 pt over the rule); with one spot the rule only
+/// matters next to a Latin run, where almost half a point is allowed.
+fn slop(k: usize, first_line: bool) -> Abs {
+    // Measured: a paragraph's first line gets about 0.65 pt shared among
+    // the k+1 parts (six-spot lines fit 0.1 pt more, two-spot lines 0.2 pt
+    // more); later lines get nothing (a six-spot second line was refused
+    // 0.001 pt over the rule).
+    if !first_line {
+        return Abs::zero();
+    }
+    match k {
+        1 => Abs::pt(0.45),
+        _ => Abs::pt(0.65),
+    }
+}
+
+/// The kind of a token.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Kind {
+    /// A CJK character (or another full-width character) occupying a cell.
+    Cjk,
+    /// Full-width closing punctuation.
+    Close,
+    /// Full-width opening punctuation.
+    Open,
+    /// A run of Latin (non-CJK) glyphs, an inline frame, or other rigid
+    /// content.
+    Latin,
+    /// A space or explicit horizontal spacing.
+    Space,
+}
+
+/// A unit of the paragraph for the purposes of Word's line breaking.
+#[derive(Debug, Clone)]
+struct Tok {
+    kind: Kind,
+    /// The byte range in the paragraph's text.
+    range: Range,
+    /// The first character (for CJK kinds, the character itself).
+    c: char,
+    /// First and last character of a Latin run.
+    head: Option<char>,
+    tail: Option<char>,
+    /// The font size of the token's glyphs.
+    size: Abs,
+    /// The raw width: the natural advance of a CJK glyph, the sum of the
+    /// shaped advances of a Latin run, the shaped width of a space, or the
+    /// width of a frame.
+    w: Abs,
+    /// Whether the token's width cannot be changed (frames, explicit spacing).
+    rigid: bool,
+    /// An East Asian symbol (Greek, `℃`, `→`, `•`...): a cell of its own
+    /// like a CJK character, but without automatic spacing next to it.
+    symbol: bool,
+    /// A Latin run whose first/last glyph is an accented letter drawn by
+    /// the East Asian font: no automatic spacing on that side.
+    ea_head: bool,
+    ea_tail: bool,
+    /// Explicit spacing (`h(..)`) rather than a space character.
+    user: bool,
+    /// Weak explicit spacing that vanishes at line boundaries.
+    weak: bool,
+    /// The natural width in the line (computed by `natural`).
+    nw: Abs,
+    /// The automatic spacing before this token (computed by `natural`).
+    gap: Abs,
+    /// Whether this token is a compression spot.
+    spot: bool,
+    /// Whether the token is a Latin run with glyphs (as opposed to a frame).
+    glyphs: bool,
+    /// The number of glyphs in a Latin run.
+    glyph_count: usize,
+    /// The shaped advance of the first glyph of a Latin run.
+    head_w: Abs,
+    /// The shaped advance of the last glyph of a Latin run.
+    tail_w: Abs,
+    /// Whether the token is an inline frame (an equation, a box, ...).
+    frame: bool,
+    /// Whether this punctuation mark is halved because another full-width
+    /// punctuation mark follows (Word with font kerning on). At the end of a
+    /// line it is full width again.
+    paired: bool,
+    /// The full natural width, for a paired mark that ends a line.
+    full: Abs,
+    /// For a Latin run: the shaped width of its trailing ASCII closing
+    /// punctuation (`.`, `,`, `)`, `%`...), which may hang into the margin.
+    tail_hang: Abs,
+    /// A syllable of a hyphenated word that may end a line with a hyphen.
+    hyph_after: bool,
+    /// The width of that hyphen (with the grid's Latin excess).
+    hyph_w: Abs,
+    /// The advance of the run's second glyph (zero for a single glyph).
+    second_w: Abs,
+    /// A syllable of a word glued to CJK text or full-width punctuation.
+    glued: bool,
+}
+
+/// Paragraph-level parameters.
+struct Params {
+    compat: u8,
+    /// Whether a character grid is in effect.
+    grid: bool,
+    /// The excess of a grid cell over the font size.
+    excess: Abs,
+    /// The cell width at the paragraph's font size.
+    cell: Abs,
+    adjust_right_indent: bool,
+    /// Whether Word's font kerning is on (halves adjacent punctuation).
+    kern: bool,
+    /// Latin glyphs get half the grid excess (Word's "balance SBCS and DBCS
+    /// widths" option) or, without the option, all of it.
+    balance: bool,
+    justify: bool,
+    /// Whether CJK-Latin spacing is enabled.
+    autospace: bool,
+    /// The paragraph's hanging indent (already taken off the measure).
+    hanging: Abs,
+    /// The paragraph sits in a table cell (`cell: true`): closers compress
+    /// to half a cell but never hang past the cell edge, and the old modes
+    /// do not round the measure to whole cells (`out/tb-c15`, `out/tb-c11`).
+    table_cell: bool,
+    /// Whether any text of the paragraph may be hyphenated (Word's automatic
+    /// hyphenation, `text(hyphenate: true)`).
+    hyphenate: bool,
+    /// The limit on consecutive hyphenated lines (0: none).
+    consecutive_hyphens: usize,
+    /// Whether words in all capitals are hyphenated.
+    hyphenate_caps: bool,
+    /// Word's character spacing control: punctuation may be compressed
+    /// (and closers hang). Off, every unit needs its full width and a
+    /// closer that does not fit takes the character before it down (a
+    /// contest paper without the setting, `out/real/v-mm`: no compression
+    /// and no hanging in any of its 77 paragraphs).
+    compress: bool,
+}
+
+impl Params {
+    /// The amount by which every Latin glyph (and every space in Latin
+    /// context) is widened under a character grid. Measured: half the excess
+    /// of the cell over the font size, independent of the glyph's width.
+    fn latin_add(&self) -> Abs {
+        if !self.grid {
+            Abs::zero()
+        } else if self.balance {
+            self.excess / 2.0
+        } else {
+            self.excess
+        }
+    }
+
+    /// The automatic spacing between a CJK character and Latin text: a
+    /// quarter of the font size, plus a fifth of the grid excess (measured
+    /// with indent sweeps: a block's two gaps together carry two fifths).
+    fn auto_at(&self, size: Abs) -> Abs {
+        // A fifth of the excess at the usual 12.45 pt pitch (measured with
+        // left-aligned sweeps). Word 2013 widens it faster at wider pitches
+        // and stops at 0.2 pt (fitted on the fine charSpace sweeps of the
+        // p15 probe sets, 12.6-12.85 pt); the older modes keep a fifth.
+        if !self.autospace {
+            return Abs::zero();
+        }
+        let ex = self.excess;
+        if self.compat == 15 {
+            size / 4.0 + (ex / 5.0).max((ex - Abs::pt(0.26)) * 0.46).min(Abs::pt(0.2))
+        } else {
+            size / 4.0 + ex / 5.0
+        }
+    }
+}
+
+/// The byte ranges of the East Asian symbols of the paragraph: characters
+/// that Word, in a run hinted as East Asian, draws with the East Asian font
+/// and treats as East Asian text for breaking (Greek letters, `℃`, `→`,
+/// `•`, `×`, `°`...). The font decides, as it does in Word: a glyph drawn
+/// by a CJK font, or one outside the Latin font's Word coverage that had to
+/// fall back to another font (`−` is not in `SimSun`).
+fn symbol_ranges(
+    p: &Preparation,
+) -> (Vec<std::ops::Range<usize>>, Vec<std::ops::Range<usize>>) {
+    let mut out = Vec::new();
+    // Accented Latin letters drawn by the East Asian font: Latin for
+    // breaking, but without automatic spacing next to them (`咖啡café汉`:
+    // no spacing after `é`, measured in both modes).
+    let mut letters = Vec::new();
+    for (_, item) in &p.items {
+        let Item::Text(shaped) = item else { continue };
+        let first_family = families(shaped.styles).next();
+        let first = first_family.map(|f| f.as_str().to_owned());
+        // A run whose first family is a CJK font without a coverage limit
+        // stands for a Word run whose Latin font *is* the CJK font
+        // (`w:ascii="宋体"`) and that carries no East Asian hint: Word then
+        // draws Greek letters and symbols with that font as Latin text and
+        // never breaks inside `2D/√3≈…` (a contest paper, `out/real/v-mm`).
+        let cjk_latin_font = first_family.is_some_and(|f| f.covers().is_none())
+            && shaped.glyphs.first().is_some_and(|g| {
+                g.font.ttf().glyph_index('一').is_some()
+                    && first.as_deref().is_some_and(|f| g.font.info().family.eq_ignore_ascii_case(f))
+            });
+        let mut last_end = 0;
+        for g in shaped.glyphs.iter() {
+            if cjk_latin_font {
+                break;
+            }
+            if g.range.start < last_end {
+                continue;
+            }
+            let c = g.c;
+            // Accented Latin letters stay Latin even when the East Asian
+            // font draws them (`café` never breaks inside); Roman numerals
+            // (`Ⅱ`, Latin script too) are symbols.
+            if !c.is_ascii()
+                && c.script() == Script::Latin
+                && (c as u32) < 0x2000
+                && g.font.ttf().glyph_index('一').is_some()
+            {
+                letters.push(g.range.clone());
+                last_end = g.range.end;
+                continue;
+            }
+            if c.is_ascii()
+                || c.is_whitespace()
+                || (c.script() == Script::Latin && (c as u32) < 0x2000)
+                || CLOSERS.contains(&c)
+                || OPENERS.contains(&c)
+            {
+                continue;
+            }
+            // Full-width ASCII variants (`－`, `＋`, `Ａ`) are symbols too:
+            // a cell each without automatic spacing next to them.
+            if is_wide(c) && !('\u{FF01}'..='\u{FF5E}').contains(&c) {
+                continue;
+            }
+            let cjk_font = g.font.ttf().glyph_index('一').is_some();
+            let fallback =
+                !Covers::MswordLatin.as_regex().is_match(c.encode_utf8(&mut [0; 4]))
+                    && first
+                        .as_deref()
+                        .is_some_and(|f| !g.font.info().family.eq_ignore_ascii_case(f));
+            if cjk_font || fallback {
+                out.push(g.range.clone());
+                last_end = g.range.end;
+            }
+        }
+    }
+    out.sort_by_key(|r| r.start);
+    letters.sort_by_key(|r| r.start);
+    (out, letters)
+}
+
+/// Whether a character is written in a CJK script or is otherwise full-width.
+fn is_wide(c: char) -> bool {
+    let o = c as u32;
+    matches!(
+        c.script(),
+        Script::Han
+            | Script::Hiragana
+            | Script::Katakana
+            | Script::Hangul
+            | Script::Bopomofo
+    ) || (0x2E80..=0x2FDF).contains(&o)
+        || (0x3000..=0x30FF).contains(&o)
+        || (0x3190..=0x33FF).contains(&o)
+        || (0xF900..=0xFAFF).contains(&o)
+        || (0xFE30..=0xFE4F).contains(&o)
+        || (0xFF00..=0xFF60).contains(&o)
+        || (0xFFE0..=0xFFE6).contains(&o)
+        || (0x20000..=0x3134F).contains(&o)
+}
+
+/// Whether a Latin character gets automatic spacing next to CJK text.
+fn is_alnum(c: char) -> bool {
+    matches!(c.script(), Script::Latin | Script::Greek | Script::Cyrillic)
+        || c.is_ascii_digit()
+}
+
+/// Breaks the paragraph into lines the way Microsoft Word does.
+#[typst_macros::time]
+pub fn linebreak_msword<'a>(
+    engine: &Engine,
+    p: &'a Preparation<'a>,
+    width: Abs,
+    config: MswordLinebreaks,
+) -> Vec<Line<'a>> {
+    // Bidirectional text is not emulated.
+    if p.bidi.is_some() {
+        return super::linebreak::linebreak_simple(engine, p, width);
+    }
+
+    let base = p.config.font_size;
+    let excess = config
+        .char_excess
+        .map(|excess| excess.at(base))
+        .or_else(|| config.char_pitch.map(|pitch| pitch.at(base) - base))
+        .unwrap_or(Abs::zero());
+    let params = Params {
+        compat: config.compat,
+        grid: config.char_pitch.is_some() || config.char_excess.is_some(),
+        excess,
+        cell: base + excess,
+        adjust_right_indent: config.adjust_right_indent,
+        kern: config.kern,
+        balance: config.balance_widths,
+        justify: p.config.justify,
+        autospace: p.config.cjk_latin_spacing,
+        hanging: p.config.hanging_indent,
+        table_cell: config.cell,
+        hyphenate: p.config.hyphenate != Some(false),
+        consecutive_hyphens: config.consecutive_hyphens,
+        hyphenate_caps: config.hyphenate_caps,
+        compress: config.compress,
+    };
+
+    let (symbols, ea_letters) = symbol_ranges(p);
+    let (mut breaks, mandatory, eaten) = collect_breaks(p, &params, &symbols);
+    let (hyphens, glued) = collect_hyphens(p, &params);
+    let mut toks = tokenize(p, &params, &breaks, &hyphens, &glued, &symbols, &ea_letters);
+    // A Latin run that starts a line and does not fit on it (a long number,
+    // a URL without break opportunities) is broken by Word at the glyph
+    // that no longer fits, while a run that could move down as a whole is
+    // moved. Runs longer than half the line get an emergency break at every
+    // glyph; the fit only uses those when the run starts the line.
+    let mut emergency: Vec<usize> = Vec::new();
+    let overlong: Vec<std::ops::Range<usize>> = toks
+        .iter()
+        .filter(|t| {
+            t.kind == Kind::Latin
+                && t.glyphs
+                && t.w + params.latin_add() * t.glyph_count as f64 > width / 2.0
+        })
+        .map(|t| t.range.clone())
+        .collect();
+    if !overlong.is_empty() {
+        for (_, item) in &p.items {
+            let Item::Text(shaped) = item else { continue };
+            for g in shaped.glyphs.iter() {
+                if overlong
+                    .iter()
+                    .any(|r| r.start < g.range.start && g.range.start < r.end)
+                    && !breaks.contains(&g.range.start)
+                {
+                    emergency.push(g.range.start);
+                }
+            }
+        }
+        emergency.sort_unstable();
+        emergency.dedup();
+        breaks.extend(emergency.iter().copied());
+        breaks.sort_unstable();
+        breaks.dedup();
+        toks = tokenize(p, &params, &breaks, &hyphens, &glued, &symbols, &ea_letters);
+    }
+    if toks.is_empty() {
+        return vec![line(engine, p, 0..p.text.len(), Breakpoint::Mandatory, None, '\0')];
+    }
+    natural(&mut toks, &params);
+    if std::env::var_os("MSWORD_DEBUG").is_some() {
+        for (k, t) in toks.iter().enumerate() {
+            eprintln!(
+                "tok {} {:?} {:?} nw={:.3} gap={:.3} spot={} paired={} w={:.3} hang={:.3} range={:?} sym={} brk={}",
+                k,
+                t.kind,
+                t.c,
+                t.nw.to_pt(),
+                t.gap.to_pt(),
+                t.spot,
+                t.paired,
+                t.w.to_pt(),
+                t.tail_hang.to_pt(),
+                t.range,
+                t.symbol,
+                breaks.binary_search(&t.range.start).is_ok()
+            );
+        }
+    }
+
+    let decided = decide(&toks, &params, width, &breaks, &emergency, &mandatory, p.text);
+
+    let mut lines = Vec::with_capacity(decided.len());
+    let mut start = 0;
+    for d in decided {
+        let ate = eaten.get(&d.end).copied().unwrap_or('\0');
+        let mut built = line(engine, p, start..d.end, d.breakpoint, lines.last(), ate);
+        render(&mut built, &toks, &d, &params, width);
+        start = d.end;
+        lines.push(built);
+    }
+    lines
+}
+
+/// Collects the legal break offsets (sorted) and the mandatory ones.
+fn collect_breaks(
+    p: &Preparation,
+    params: &Params,
+    symbols: &[std::ops::Range<usize>],
+) -> (Vec<usize>, Vec<usize>, HashMap<usize, char>) {
+    let mut breaks = Vec::new();
+    let mut mandatory = Vec::new();
+    let mut eaten = HashMap::new();
+    breakpoints(p, |offset, bp, ate| match bp {
+        Breakpoint::Normal => {
+            breaks.push(offset);
+            eaten.insert(offset, ate);
+        }
+        Breakpoint::Mandatory => {
+            breaks.push(offset);
+            mandatory.push(offset);
+            eaten.insert(offset, ate);
+        }
+        // Hyphenation is not part of the emulation.
+        Breakpoint::Hyphen(..) => {}
+    });
+
+    // Word 2003/2007/2010 do not break after a hyphen inside a word; Word 2013
+    // and later do. No version breaks a dash away from a following digit
+    // (`13—93`).
+    let text = p.text;
+    // Word 2013+ also breaks after a hyphen between digits (`117-121`),
+    // which UAX #14 does not; and every version breaks before a slash that
+    // follows a digit (`201910/24`).
+    for (i, c) in text.char_indices() {
+        if i == 0 {
+            continue;
+        }
+        let before = text[..i].chars().next_back();
+        if c == '-' && params.compat == 15 {
+            let next = text[i + 1..].chars().next();
+            if before.is_some_and(|b| b.is_ascii_digit())
+                && next.is_some_and(|n| n.is_ascii_digit())
+            {
+                breaks.push(i + 1);
+            }
+        }
+        if c == '/'
+            && before.is_some_and(|b| b.is_ascii_digit())
+            && text[i + 1..].chars().next().is_some_and(|n| n.is_ascii_digit())
+        {
+            breaks.push(i);
+        }
+        // Word breaks between two em dashes (`——`), UAX #14 does not.
+        if c == '—' && before == Some('—') {
+            breaks.push(i);
+        }
+        // Word breaks after any space, also before `/`, `]`, `)`... which
+        // UAX #14 keeps glued to the text before the space. A narrow
+        // no-break space (U+202F, left by unit spacing like `1720 cm-1`,
+        // `900 °C`) is a breaking space to Word as well, in every mode.
+        if matches!(before, Some(' ' | '\u{202F}')) && c != ' ' {
+            breaks.push(i);
+        }
+        // An ASCII quote breaks from a CJK character on either side
+        // (`英文"ab"时`), which UAX #14 glues; the 2003 layout also breaks
+        // between an operator and a CJK character (`龙+|云`), Word 2013+
+        // keeps `Fe2+具` together as UAX #14 does.
+        const QUOTES: &[char] = &['"', '\''];
+        const OPERATORS: &[char] =
+            &['+', '=', '<', '>', '~', '&', '*', '@', '#', '^', '|'];
+        let mark = |c: char| {
+            QUOTES.contains(&c) || (params.compat != 15 && OPERATORS.contains(&c))
+        };
+        if (mark(c) && before.is_some_and(is_wide))
+            || (before.is_some_and(mark) && is_wide(c))
+        {
+            breaks.push(i);
+        }
+        // A slash or hyphen right after a CJK character may start the next
+        // line (`调用|/exit`, `接近|-near`, `定位|-追踪` in a contest paper).
+        if matches!(c, '/' | '-') && before.is_some_and(is_wide) {
+            breaks.push(i);
+        }
+    }
+    // An East Asian symbol breaks from its neighbours on both sides like a
+    // CJK character (`800°|C`, `0.22|μm`, `及π|-π`, `SO4|•−`), subject to
+    // the rules below.
+    for r in symbols {
+        breaks.push(r.start);
+        breaks.push(r.end);
+    }
+    let is_symbol = |offset: usize| symbols.iter().any(|r| r.start == offset);
+    let latin_alnum = |c: Option<char>| c.is_some_and(|c| c.is_ascii_alphanumeric());
+    breaks.retain(|&offset| {
+        let before = text[..offset].chars().next_back();
+        let after = text[offset..].chars().next();
+        // A curly quote glued to Latin text is part of the word
+        // (`Beginners“` in a German thesis moves down as a whole); typst's
+        // Chinese tailoring breaks before `“`, which only holds for a
+        // full-width quote (handled by the opener rule in `decide`).
+        let ascii_glyph = |c: Option<char>| c.is_some_and(|c| c.is_ascii_graphic());
+        if (matches!(after, Some('“' | '‘' | '„')) && ascii_glyph(before))
+            || (matches!(before, Some('”' | '’')) && ascii_glyph(after))
+        {
+            return false;
+        }
+        // A connector symbol (dash, ellipsis, `‖`) stays with Latin text
+        // before it in Word 2013+; the 2003 layout breaks on both sides of
+        // an East Asian dash (`[73|–75]` and `[73–|75]` both measured).
+        if let Some(a) = after
+            && CONNECTORS.contains(&a)
+            && is_symbol(offset)
+            && latin_alnum(before)
+            && params.compat == 15
+        {
+            return false;
+        }
+        // Word's extra opportunities must not defeat a word joiner (UAX #14
+        // LB11), e.g. the spacing of a table-of-contents leader glued to
+        // its entry with `sym.wj`.
+        if matches!(before, Some('\u{2060}' | '\u{FEFF}'))
+            || matches!(after, Some('\u{2060}' | '\u{FEFF}'))
+        {
+            return false;
+        }
+        // Word's kinsoku: `%`, `℃`, `°`... never start a line (also after a
+        // space: `提高 20 %，` keeps `%，` on the line), `$`, `(`... never
+        // end one.
+        // (A narrow no-break space lets a symbol start the next line:
+        // `（>700\u{202F}|°C）` in a thesis, the space itself stays in the
+        // Latin run before it.)
+        if (after.is_some_and(|c| NO_LINE_START.contains(&c))
+            && before != Some('\u{202F}'))
+            || before.is_some_and(|c| NO_LINE_END.contains(&c))
+        {
+            return false;
+        }
+        let hyphen_break =
+            before == Some('-') && after.is_some_and(|c| c.is_ascii_alphanumeric());
+        // Word does not break after a slash inside a word (`GB/T`, URLs),
+        // nor before one that follows a letter, nor after a period followed
+        // by a letter (`www.example`). A CJK character after the slash or
+        // period is a break opportunity (`.cn/云`).
+        // (`2D/√3≈…` and `n≥[2π/(4r)]` in a contest paper stay whole too:
+        // anything but a space or a CJK character after the slash keeps
+        // it glued, and anything but a digit, a space or a CJK character
+        // before it.)
+        let glued_char = |c: char| !c.is_whitespace() && !is_wide(c);
+        let slash = (before == Some('/') && after.is_some_and(glued_char))
+            || (after == Some('/')
+                && before.is_some_and(|c| glued_char(c) && !c.is_ascii_digit()))
+            || (before == Some('.') && after.is_some_and(|c| c.is_ascii_alphanumeric()));
+        // ...a dash drawn by the Latin font (a run without the eastAsia
+        // hint); an East Asian dash follows the connector rule above.
+        let dash_digit = (matches!(before, Some(b @ ('—' | '–')) if !is_symbol(offset - b.len_utf8()))
+            && after.is_some_and(|c| c.is_ascii_digit()))
+            || (matches!(after, Some('—' | '–'))
+                && !is_symbol(offset)
+                && before.is_some_and(|c| c.is_ascii_digit()));
+        !((params.compat != 15 && hyphen_break) || dash_digit || slash)
+    });
+
+    breaks.sort_unstable();
+    breaks.dedup();
+    (breaks, mandatory, eaten)
+}
+
+/// Splits the paragraph into tokens.
+/// The hyphenation points (byte offsets inside words) of the paragraph's
+/// text where `text(hyphenate: true)` is in effect: Word's automatic
+/// hyphenation. Words in a language without patterns (a Chinese paragraph
+/// whose Latin runs are English, as in a thesis whose Latin language is
+/// en-US) use the English patterns.
+fn collect_hyphens(p: &Preparation, params: &Params) -> (Vec<usize>, Vec<usize>) {
+    let mut out = Vec::new();
+    // Points of words glued to CJK text or full-width punctuation: only
+    // usable on a line that already carries a wide Latin span.
+    let mut glued = Vec::new();
+    if !params.hyphenate {
+        return (out, glued);
+    }
+    let hyphenate_at = |offset: usize| -> bool {
+        p.config.hyphenate.unwrap_or_else(|| {
+            let (_, item) = p.get(offset);
+            item.text()
+                .map(|text| text.styles.get(TextElem::hyphenate).unwrap_or(false))
+                .unwrap_or(false)
+        })
+    };
+    let lang_at = |offset: usize| -> hypher::Lang {
+        let lang = p.config.lang.or_else(|| {
+            let (_, item) = p.get(offset);
+            Some(item.text()?.styles.get(TextElem::lang))
+        });
+        lang.and_then(|lang| {
+            let bytes = lang.as_str().as_bytes().try_into().ok()?;
+            hypher::Lang::from_iso(bytes)
+        })
+        .unwrap_or(hypher::Lang::English)
+    };
+    // Word only hyphenates a word that follows a space (or starts the
+    // paragraph), ASCII punctuation in between allowed: a word glued to a
+    // CJK character or to full-width punctuation (`成岁information`,
+    // `（information）`) is never hyphenated, one after a space is, even
+    // with CJK text right after it (`out/hy-c*`).
+    // The parts of a hyphenated compound are words of their own
+    // (`metal-im-pregnated`, `machine-learn-ing` in a reference list), but
+    // the whole ASCII chunk counts: `（L-histidine`, `（2,2,6,6-Tetramethyl`
+    // and a URL after `（` are glued.
+    // (A URL glued to CJK text is sometimes hyphenated by Word
+    // (`数据集http://bio-char.ucdavis.edu/）` in a thesis, `out/hy-x24`
+    // `ab://den-sity.org/` after `UC Davis` on the line) and sometimes not
+    // (`可在https://academic.oup.com/…`, `（https://automeris.io/…）`,
+    // `out/hy-x19` `http://density.org/）` alone on the line): not
+    // modelled, URLs count as glued like any chunk.)
+    let after_space = |start: usize| -> bool {
+        let mut it = p.text[..start].chars().rev();
+        loop {
+            match it.next() {
+                None => return true,
+                Some(c) if c.is_whitespace() => return true,
+                Some(c) if c.is_ascii() => {}
+                Some(_) => return false,
+            }
+        }
+    };
+    let mut offset = 0;
+    for segment in p.text.split_word_bounds() {
+        let len = segment.len();
+        // Letters with digits among them are hyphenated at the points of
+        // their letter runs (`out/hy-an`: `connec-tomeDB2020`,
+        // `Bac-cin2020`, `H1N1vi-rus`, `2020infor-mation`; `GSE149614data`
+        // has none, `da-ta` leaving two letters).
+        // (UAX #29 keeps `density.org` as one segment: the dots split it
+        // into runs like the digits do — `www.den-sity.org/` after a
+        // line-leading glued run, `out/hy-x24`/`x26`.)
+        let word = segment.chars().filter(|c| c.is_alphabetic()).count() >= 2
+            && segment.chars().all(|c| (c.is_alphanumeric() || c == '.') && !is_wide(c));
+        if word
+            && hyphenate_at(offset)
+            && (params.hyphenate_caps
+                || !segment.chars().filter(|c| c.is_alphabetic()).all(char::is_uppercase))
+        {
+            // Word 2003-2010 leave as little as two letters after the hyphen
+            // (`approximate-ly`, `comput-er`, `process-es`, `out/hy-suf11`),
+            // Word 2013+ three (`out/hy-suf15`); two before in every mode.
+            let right_min = if params.compat == 15 { 3 } else { 2 };
+            let lang = lang_at(offset);
+            let mut run_start = 0;
+            while run_start < len {
+                let c = segment[run_start..].chars().next().unwrap();
+                if !c.is_alphabetic() {
+                    run_start += c.len_utf8();
+                    continue;
+                }
+                let mut run_end = run_start;
+                while let Some(c) = segment[run_end..].chars().next()
+                    && c.is_alphabetic()
+                {
+                    run_end += c.len_utf8();
+                }
+                let run = &segment[run_start..run_end];
+                if run.chars().count() >= 2 {
+                    let mut at = offset + run_start;
+                    for syllable in hypher::hyphenate_bounded(run, lang, 2, right_min) {
+                        at += syllable.len();
+                        if at < offset + run_end {
+                            out.push(at);
+                            if !after_space(offset) {
+                                glued.push(at);
+                            }
+                        }
+                    }
+                }
+                run_start = run_end;
+            }
+        }
+        offset += len;
+    }
+    (out, glued)
+}
+
+fn tokenize(
+    p: &Preparation,
+    params: &Params,
+    breaks: &[usize],
+    hyphens: &[usize],
+    glued: &[usize],
+    symbols: &[std::ops::Range<usize>],
+    ea_letters: &[std::ops::Range<usize>],
+) -> Vec<Tok> {
+    let mut toks: Vec<Tok> = Vec::new();
+    let is_break = |offset: usize| breaks.binary_search(&offset).is_ok();
+    let is_hyphen = |offset: usize| hyphens.binary_search(&offset).is_ok();
+    let is_glued = |offset: usize| glued.binary_search(&offset).is_ok();
+    let is_symbol =
+        |offset: usize| symbols.binary_search_by_key(&offset, |r| r.start).is_ok();
+    let is_ea_letter =
+        |offset: usize| ea_letters.binary_search_by_key(&offset, |r| r.start).is_ok();
+
+    for (range, item) in &p.items {
+        match item {
+            Item::Text(shaped) => {
+                let tracking = shaped.styles.resolve(TextElem::tracking);
+                // `text(spacing: 8pt)` (an absolute length, no ratio) makes
+                // every space a fixed-width blank, as used for fill lines;
+                // a relative spacing or tracking only changes the natural
+                // width of a space that still stretches and shrinks.
+                let spacing = shaped.styles.resolve(TextElem::spacing);
+                let fixed_spaces = spacing.rel.is_zero() && !spacing.abs.is_zero();
+                let glyphs = &*shaped.glyphs;
+                let mut i = 0;
+                while i < glyphs.len() {
+                    // A cluster: all glyphs with the same range.
+                    let mut j = i + 1;
+                    while j < glyphs.len() && glyphs[j].range == glyphs[i].range {
+                        j += 1;
+                    }
+                    let g = &glyphs[i];
+                    let cluster = &glyphs[i..j];
+                    let size = g.size;
+                    let shaped_w: Abs =
+                        cluster.iter().map(|g| g.x_advance.at(g.size)).sum();
+                    let c = g.c;
+                    let natural = g
+                        .font
+                        .x_advance(g.glyph_id)
+                        .map(|adv| adv.at(size))
+                        .unwrap_or(shaped_w);
+                    // A symbol the font renders full width (Word with the
+                    // eastAsia hint draws ×, °, ■... with the CJK font) is
+                    // still a Latin glyph to Word 2013+: measured `××××年`
+                    // at 12.23 pt per × under a 12.45 pt grid (glyph + half
+                    // the excess), no automatic spacing next to it. Word
+                    // 2003 mode gave it a whole cell.
+                    // An East Asian symbol (see `symbol_ranges`) is a
+                    // character of its own; those that may not start a
+                    // line (`℃`, `°`, `‰`, `′`...) hang like closing
+                    // punctuation (measured: `范围a°` and `范围1℃` end a
+                    // justified line with the symbol entirely outside the
+                    // margin), connectors (`—`, `…`) do not.
+                    let symbol = is_symbol(g.range.start);
+                    let wide = !LATINISH.contains(&c) && is_wide(c);
+                    let fullwidth_punct = (CLOSERS.contains(&c) || OPENERS.contains(&c))
+                        && natural >= size * 0.9;
+                    let cjk_kind = if symbol {
+                        Some(if NO_LINE_START.contains(&c) && !CONNECTORS.contains(&c) {
+                            Kind::Close
+                        } else {
+                            Kind::Cjk
+                        })
+                    } else if fullwidth_punct {
+                        Some(if CLOSERS.contains(&c) { Kind::Close } else { Kind::Open })
+                    } else if wide && !CLOSERS.contains(&c) && !OPENERS.contains(&c) {
+                        Some(Kind::Cjk)
+                    } else {
+                        // Wide but rendered narrow (a font without the
+                        // full-width glyph): treat like Latin.
+                        None
+                    };
+
+                    if super::shaping::is_space(c) {
+                        // A space under an absolute `text(spacing:)` is
+                        // explicit spacing: it keeps that width instead of
+                        // Word's half-cell rule for spaces next to CJK text
+                        // and never stretches (fill lines made of underlined
+                        // spaces rely on this).
+                        let explicit = fixed_spaces && c != '\u{00A0}';
+                        toks.push(Tok {
+                            kind: Kind::Space,
+                            range: g.range.clone(),
+                            c,
+                            head: None,
+                            tail: None,
+                            size,
+                            w: shaped_w,
+                            rigid: explicit,
+                            symbol: false,
+                            ea_head: false,
+                            ea_tail: false,
+                            user: explicit,
+                            weak: false,
+                            nw: Abs::zero(),
+                            gap: Abs::zero(),
+                            spot: false,
+                            glyphs: true,
+                            glyph_count: 1,
+                            head_w: shaped_w,
+                            tail_w: shaped_w,
+                            frame: false,
+                            paired: false,
+                            full: Abs::zero(),
+                            tail_hang: Abs::zero(),
+                            hyph_after: false,
+                            hyph_w: Abs::zero(),
+                            second_w: Abs::zero(),
+                            glued: false,
+                        });
+                    } else if let Some(kind) = cjk_kind {
+                        // The font advance plus `text(tracking:)`; the shaped
+                        // advance cannot be used because typst's shaping
+                        // already halves adjacent CJK punctuation.
+                        toks.push(Tok {
+                            kind,
+                            range: g.range.clone(),
+                            c,
+                            head: None,
+                            tail: None,
+                            size,
+                            w: natural + tracking,
+                            rigid: false,
+                            symbol,
+                            ea_head: false,
+                            ea_tail: false,
+                            user: false,
+                            weak: false,
+                            nw: Abs::zero(),
+                            gap: Abs::zero(),
+                            spot: false,
+                            glyphs: true,
+                            glyph_count: 1,
+                            head_w: Abs::zero(),
+                            tail_w: Abs::zero(),
+                            frame: false,
+                            paired: false,
+                            full: Abs::zero(),
+                            tail_hang: Abs::zero(),
+                            hyph_after: false,
+                            hyph_w: Abs::zero(),
+                            second_w: Abs::zero(),
+                            glued: false,
+                        });
+                    } else {
+                        // Latin: extend the current run unless a break
+                        // opportunity separates them.
+                        let extend = matches!(
+                            toks.last(),
+                            Some(last) if last.kind == Kind::Latin
+                                && last.glyphs
+                                && last.range.end == g.range.start
+                                && !is_break(g.range.start)
+                                && !is_hyphen(g.range.start)
+                                && !LATINISH.contains(&last.tail.unwrap_or(' '))
+                        );
+                        let ea = is_ea_letter(g.range.start);
+                        // A hyphenation point: the run so far is a syllable
+                        // that may end a line with a hyphen in this font.
+                        if !extend
+                            && is_hyphen(g.range.start)
+                            && let Some(last) = toks.last_mut()
+                            && last.kind == Kind::Latin
+                            && last.range.end == g.range.start
+                        {
+                            last.hyph_after = true;
+                            last.glued = is_glued(g.range.start);
+                            last.hyph_w = g
+                                .font
+                                .ttf()
+                                .glyph_index('-')
+                                .and_then(|id| g.font.x_advance(id.0))
+                                .map(|adv| adv.at(size))
+                                .unwrap_or(size / 3.0);
+                        }
+                        if extend {
+                            let last = toks.last_mut().unwrap();
+                            last.range.end = g.range.end;
+                            last.w += shaped_w;
+                            last.tail = Some(c);
+                            last.tail_w = shaped_w;
+                            if last.glyph_count == 1 {
+                                last.second_w = shaped_w;
+                            }
+                            last.ea_tail = ea;
+                            last.glyph_count += cluster.len();
+                            // Only the last mark hangs (measured: `(word),`
+                            // and `[12].` hang 3 pt, `(2019)` 4 pt).
+                            last.tail_hang = if ASCII_CLOSE.contains(&c) {
+                                shaped_w
+                            } else {
+                                Abs::zero()
+                            };
+                        } else {
+                            toks.push(Tok {
+                                kind: Kind::Latin,
+                                range: g.range.clone(),
+                                c,
+                                head: Some(c),
+                                tail: Some(c),
+                                size,
+                                w: shaped_w,
+                                rigid: false,
+                                symbol: false,
+                                ea_head: ea,
+                                ea_tail: ea,
+                                user: false,
+                                weak: false,
+                                nw: Abs::zero(),
+                                gap: Abs::zero(),
+                                spot: false,
+                                glyphs: true,
+                                glyph_count: 1,
+                                head_w: shaped_w,
+                                tail_w: shaped_w,
+                                frame: false,
+                                paired: false,
+                                full: Abs::zero(),
+                                tail_hang: if ASCII_CLOSE.contains(&c) {
+                                    shaped_w
+                                } else {
+                                    Abs::zero()
+                                },
+                                hyph_after: false,
+                                hyph_w: Abs::zero(),
+                                second_w: Abs::zero(),
+                                glued: false,
+                            });
+                        }
+                    }
+                    i = j;
+                }
+            }
+            Item::Absolute(amount, weak) => {
+                // A nudge below 0.0025 pt (`h(0.001pt)` before
+                // an opener in iota-hit's defense table, a hint for typst's
+                // own breaker) has no Word counterpart: zero width, so it
+                // cannot push a line of whole cells over the grid.
+                let amount =
+                    if amount.abs() < Abs::pt(0.0025) { Abs::zero() } else { *amount };
+                toks.push(Tok {
+                    kind: Kind::Space,
+                    range: range.clone(),
+                    c: ' ',
+                    head: None,
+                    tail: None,
+                    size: params.cell,
+                    w: amount,
+                    rigid: true,
+                    symbol: false,
+                    ea_head: false,
+                    ea_tail: false,
+                    user: true,
+                    weak: *weak,
+                    nw: Abs::zero(),
+                    gap: Abs::zero(),
+                    spot: false,
+                    glyphs: false,
+                    glyph_count: 0,
+                    head_w: Abs::zero(),
+                    tail_w: Abs::zero(),
+                    frame: false,
+                    paired: false,
+                    full: Abs::zero(),
+                    tail_hang: Abs::zero(),
+                    hyph_after: false,
+                    hyph_w: Abs::zero(),
+                    second_w: Abs::zero(),
+                    glued: false,
+                });
+            }
+            Item::Frame(frame) => {
+                toks.push(Tok {
+                    kind: Kind::Latin,
+                    range: range.clone(),
+                    c: '\u{FFFC}',
+                    head: None,
+                    tail: None,
+                    size: params.cell,
+                    w: frame.width(),
+                    rigid: true,
+                    symbol: false,
+                    ea_head: false,
+                    ea_tail: false,
+                    user: false,
+                    weak: false,
+                    nw: Abs::zero(),
+                    gap: Abs::zero(),
+                    spot: false,
+                    glyphs: false,
+                    glyph_count: 0,
+                    head_w: Abs::zero(),
+                    tail_w: Abs::zero(),
+                    frame: true,
+                    paired: false,
+                    full: Abs::zero(),
+                    tail_hang: Abs::zero(),
+                    hyph_after: false,
+                    hyph_w: Abs::zero(),
+                    second_w: Abs::zero(),
+                    glued: false,
+                });
+            }
+            Item::Fractional(..) => {
+                // Fractional spacing takes what is left after the line is
+                // fixed; for breaking it is zero-width explicit spacing.
+                toks.push(Tok {
+                    kind: Kind::Space,
+                    range: range.clone(),
+                    c: ' ',
+                    head: None,
+                    tail: None,
+                    size: params.cell,
+                    w: Abs::zero(),
+                    rigid: true,
+                    symbol: false,
+                    ea_head: false,
+                    ea_tail: false,
+                    user: true,
+                    weak: false,
+                    nw: Abs::zero(),
+                    gap: Abs::zero(),
+                    spot: false,
+                    glyphs: false,
+                    glyph_count: 0,
+                    head_w: Abs::zero(),
+                    tail_w: Abs::zero(),
+                    frame: false,
+                    paired: false,
+                    full: Abs::zero(),
+                    tail_hang: Abs::zero(),
+                    hyph_after: false,
+                    hyph_w: Abs::zero(),
+                    second_w: Abs::zero(),
+                    glued: false,
+                });
+            }
+            Item::Tag(_) | Item::Skip(_) => {}
+        }
+    }
+
+    toks
+}
