+        // `hy-m11*`): a word that does not fit is broken at the last
+        // hyphenation point whose syllable fits with the ordinary unit
+        // budget (2013 mode squeezes the Latin spaces of the line for it,
+        // 2003 mode does not), whatever the hyphenation zone — Word ignores
+        // the zone setting in every mode measured (0, 360, 1440 twips
+        // alike), justified or left-aligned.
+        let consecutive =
+            lines.iter().rev().take_while(|l| l.breakpoint.is_hyphen()).count();
