+        let w = width_of(toks, first, last);
+        let capacity = cap_for(last);
+        let target = capacity;
+        if std::env::var_os("MSWORD_DEBUG").is_some() {
+            eprintln!(
+                "line {first}..={last} end={end} {breakpoint:?} w={:.3} cap={:.3} forced={forced}",
+                w.to_pt(),
+                capacity.to_pt()
+            );
+        }
+        lines.push(Decided {
+            first,
+            last,
+            end,
+            breakpoint,
+            target,
+            over: w - capacity,
+            deep: deep && toks[last].kind == Kind::Close,
+            forced,
+            ragged,
+        });
+
+        i = last + 1;
+        // Spaces at the break are trimmed at the end of this line.
+        while i < n
+            && toks[i].kind == Kind::Space
+            && !toks[i].user
+            && toks[i].range.start < end
+        {
+            i += 1;
+        }
+        if end >= text_len {
+            break;
+        }
+    }
+    lines
+}
