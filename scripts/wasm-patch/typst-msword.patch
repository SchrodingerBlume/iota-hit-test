+/// Applies Word's glyph widths, compression and justification to a line.
+fn render(built: &mut Line, toks: &[Tok], d: &Decided, params: &Params, measure: Abs) {
+    let compat = params.compat;
+    let p = params.cell;
+    let half = p / 2.0;
+    let first = d.first;
+    let last = d.last;
+
+    // Per-token adjustment of the width (compression, negative) and the
+    // slack added after the token.
+    let count = last - first + 1;
+    let mut delta = vec![Abs::zero(); count];
+    let mut after = vec![Abs::zero(); count];
+
+    // A closer hung whole past the margin, or compressed in place at the
+    // end of a line whose text is then justified (see below).
+    let mut whole_hang = false;
+    let mut in_place = false;
+    // Compression.
+    if d.over > Abs::zero() && !d.forced {
+        // An opener at the start of the text (also after the indent or
+        // other leading spacing) keeps its blank, as in the fit decision;
+        // measured with `（1）学校…` after a two-character indent: Word
+        // compresses the two closers and hangs the comma at the line end.
+        let mut start = first;
+        while start < last && toks[start].kind == Kind::Space {
+            start += 1;
+        }
+        let spot_idx: Vec<usize> = (first..=last)
+            .filter(|&k| toks[k].spot && !(toks[k].kind == Kind::Open && k == start))
+            .filter(|&k| !(d.deep && k == last))
+            .collect();
+        let mut need = d.over;
+        // Word 2013 takes from the spaces of a Latin run first, up to a
+        // quarter of each (measured: `Times New Roman` in a squeezed line
+        // shows 2.24/2.5 pt spaces while the closers lost 1.45 pt each),
+        // then from the punctuation.
+        if compat == 15 && params.justify {
+            // The same allowances as in the fit: a quarter of a space,
+            // nothing in a run of spaces or for a half-cell space right
+            // before the last unit.
+            let unit_start = {
+                let mut u = last;
+                while u > first && matches!(toks[u].kind, Kind::Close) {
+                    u -= 1;
+                }
+                u
+            };
+            let give = |k: usize| -> Abs {
+                let t = &toks[k];
+                if t.kind != Kind::Space || t.user {
+                    return Abs::zero();
+                }
+                if t.rigid
+                    && k < unit_start
+                    && (k + 1..unit_start).all(|i| toks[i].kind == Kind::Space)
+                {
+                    return Abs::zero();
+                }
+                let in_run = (k > 0 && toks[k - 1].kind == Kind::Space)
+                    || (k + 1 < toks.len() && toks[k + 1].kind == Kind::Space);
+                if in_run {
+                    return Abs::zero();
+                }
+                let after_punct = k > 0
+                    && matches!(toks[k - 1].kind, Kind::Close | Kind::Open)
+                    && !toks[k - 1].symbol;
+                if after_punct { t.nw } else { t.nw * 0.25 }
+            };
+            let spaces: Vec<(usize, Abs)> = (first + 1..last)
+                .map(|k| (k, give(k)))
+                .filter(|&(_, g)| g > Abs::zero())
+                .collect();
+            if !spaces.is_empty() {
+                let cap: Abs = spaces.iter().map(|&(_, g)| g).sum();
+                let take = need.min(cap);
