+                glyph.is_justifiable = false;
+            }
+            break;
+        }
+    }
+
+    // Explicit spacing and frames are not touched; the line width follows.
+    built.width = built.items.iter().map(Item::natural_width).sum();
+    built.fixed = true;
+    built.justify = false;
+    let _ = measure;
+}
