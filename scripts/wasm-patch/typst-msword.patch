+                && !(it.symbol
+                    && compat != 15
+                    && breaks.binary_search(&it.range.start).is_ok())
+            {
+                // A closer at the start of a unit (after a space, or at the
+                // line start) cannot be squeezed in — except a symbol
+                // closer after a narrow no-break space in the old layouts:
+                // 2007/2010 hang it whole (`结构在900°|C`), 2003 squeezes
+                // it in by half a cell (`达到800 °|C` at 508.45).
+                break;
+            }
+            if it.kind == Kind::Latin
+                && it.head.is_some_and(|c| ASCII_CLOSE.contains(&c))
+                && !(j > first && toks[j - 1].kind == Kind::Space && !toks[j - 1].user)
+            {
