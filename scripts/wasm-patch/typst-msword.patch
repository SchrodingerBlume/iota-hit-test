+            && (params.consecutive_hyphens == 0
+                || consecutive < params.consecutive_hyphens);
+        // A word glued to CJK text or full-width punctuation is hyphenated
+        // only on a line that already has, before it, a Latin span of at
+        // least two words about 137 pt wide that itself starts after a
+        // space or punctuation (`out/hy-x12`–`x18`: `（Kmeans Clustering
+        // Method）` before `方法（Den-` enables it, `（K-means Clustering）`,
+        // a 26-letter word, or the same span glued to a CJK character do
+        // not; the width threshold sits between 131 and 137 pt under the
+        // grid, 138 and 144 without one — not understood, taken as 137).
+        let wide_span_before = |first: usize, j: usize| -> bool {
+            let letters = |k: usize| {
+                toks[k].kind == Kind::Latin
+                    && toks[k].glyphs
+                    && text[toks[k].range.clone()].chars().any(char::is_alphabetic)
+            };
+            // A line that starts with a Latin run glued to what follows
+            // (`Deep实现了…`, `12地…`, `Deep，地…`, `Baccin2020、…`) also
+            // hyphenates its glued words, `（Density）` and URLs included
+            // (`out/hy-x23`/`x24`/`x26`: the thesis line `DeepIntegration实现
+            // 了…表明，DeepIn-`; not with a space after the run, nor with the
+            // run inside `（…）`, nor when the run sits anywhere but first —
+            // `天Deep地…` and three glued runs mid-line do nothing).
+            let start = text_start(first);
+            let alnum = |k: usize| {
+                toks[k].kind == Kind::Latin
+                    && toks[k].glyphs
+                    && text[toks[k].range.clone()].chars().any(char::is_alphanumeric)
+            };
+            if start < j && alnum(start) {
+                let mut e = start + 1;
+                while e < j
+                    && toks[e].kind == Kind::Latin
+                    && toks[e].glyphs
+                    && toks[e - 1].range.end == toks[e].range.start
+                {
+                    e += 1;
+                }
+                if e < j && !matches!(toks[e].kind, Kind::Space) {
+                    return true;
+                }
+            }
+            let mut k = text_start(first);
+            while k < j {
+                if toks[k].kind == Kind::Latin && toks[k].glyphs {
+                    let boundary = k == text_start(first)
+                        || matches!(toks[k - 1].kind, Kind::Space | Kind::Open | Kind::Close)
+                        || toks[k].head.is_some_and(|c| c.is_ascii() && !c.is_ascii_alphanumeric());
+                    let mut e = k;
+                    let mut spaces = 0;
+                    let mut seps = 0;
+                    let mut w = Abs::zero();
+                    while e < j {
+                        let t = &toks[e];
+                        let inner_punct = matches!(t.kind, Kind::Close | Kind::Open)
+                            && !t.symbol
+                            && e + 1 < j
+                            && letters(e + 1);
+                        if (t.kind == Kind::Latin && t.glyphs)
+                            || (t.kind == Kind::Space && !t.user)
+                            || inner_punct
+                        {
+                            // Words of the span: separated by spaces or by
+                            // full-width punctuation between Latin words
+                            // (`（K-means Clustering，K-means）` enables,
+                            // `（Clustering，K-means）` does not).
+                            if t.kind == Kind::Space {
+                                spaces += 1;
+                            } else if inner_punct {
+                                seps += 1;
+                            }
+                            w += t.nw;
+                            e += 1;
+                        } else {
+                            break;
+                        }
+                    }
+                    // (A span glued at its start still counts when it runs
+                    // right up to the word: `寒来Kmeans Clustering Method（Den-`,
+                    // `out/hy-x26`; `类Kmeans Clustering Method[95]、…（Density）`
+                    // does not.)
+                    let adjacent = (e..j).all(|i| toks[i].kind == Kind::Open);
+                    if (boundary || adjacent) && (spaces >= 1 || seps >= 2) && w >= Abs::pt(134.0) {
+                        return true;
+                    }
+                    k = e.max(k + 1);
+                } else {
+                    k += 1;
+                }
+            }
+            false
+        };
+        let syllable_ok = |t: usize| -> bool {
+            toks[t].hyph_after
+                && (!toks[t].glued || wide_span_before(first, word_start(first, t)))
+        };
+
+        while j < n {
+            let it = &toks[j];
+            // The unit starting at `j`: openers, a character or run, and the
+            // closers after it, which may not be separated.
+            let mut m = j;
+            if it.kind == Kind::Open {
+                while m + 1 < n && toks[m + 1].kind == Kind::Open {
+                    m += 1;
+                }
+                if m + 1 < n && !matches!(toks[m + 1].kind, Kind::Close | Kind::Space) {
+                    m += 1;
+                }
+            }
+            // A hyphenated word is first tried whole, syllables and all.
+            while toks[m].kind == Kind::Latin
+                && toks[m].hyph_after
+                && m + 1 < n
+                && toks[m + 1].kind == Kind::Latin
+                && toks[m + 1].range.start == toks[m].range.end
+            {
+                m += 1;
+            }
+            let mut core = m;
+            loop {
+                let before = m;
+                // A symbol closer that may legally start a line (`°` after
+                // a narrow no-break space) is a unit of its own in every
+                // mode: Word keeps `800 °` on the line and moves `C` when
+                // the `°` fits, and moves `°C` together when it does not
+                // (`达到800 °|C`, `在900 |°C` in one thesis in 2003 mode).
+                while m + 1 < n
+                    && toks[m + 1].kind == Kind::Close
+                    && !(toks[m + 1].symbol
+                        && breaks.binary_search(&toks[m + 1].range.start).is_ok())
+                {
+                    m += 1;
+                }
+                // ASCII closing punctuation right after the unit (`［R］.`,
+                // `(x)`, `20 %，`) may not start a line either: it hangs
+                // with the unit, and full-width closers after it follow.
+                if m + 1 < n
+                    && toks[m + 1].kind == Kind::Latin
+                    && toks[m + 1].glyphs
+                    && toks[m + 1].tail_hang == toks[m + 1].w
+                    && toks[m + 1].range.start == toks[m].range.end
+                {
+                    m += 1;
+                }
+                if m == before {
+                    break;
+                }
+            }
+            let w = width_of(toks, first, m);
+            let capacity = cap_for(m);
+            let spacing = it.kind == Kind::Space;
+            if !spacing && first_unit.is_none() {
+                first_unit = Some(m);
+            }
+            if w <= capacity + EPS {
+                last = m;
+                have = have || !spacing;
+                if let Some(mm) = mandatory_after(m) {
+                    forced_end = Some(mm);
+                    break;
+                }
+                j = m + 1;
+                continue;
+            }
+            // A Latin unit may fill the whole measure, but its squeeze is
+            // measured against the whole cells (Word 2003 mode, `表明，
+            // DeepIntegration` fits with adjustRightInd off, not on).
