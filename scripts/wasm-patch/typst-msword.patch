+                        glyph.adjustability = Adjustability::default();
+                        glyph.is_justifiable = false;
+                        glyph.x_advance += Em::from_abs(add, size);
+                    }
+                    // The gap and slack go after the last glyph of the run.
+                    if let Some(glyph) = glyphs[g..e].last_mut()
+                        && glyph.range.end >= it.range.end
