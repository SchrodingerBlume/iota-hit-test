+/// Computes the natural widths, gaps and compression spots of the tokens.
+fn natural(toks: &mut [Tok], params: &Params) {
+    for k in 0..toks.len() {
+        let prev = if k > 0 { Some(toks[k - 1].clone()) } else { None };
+        // Whether a space at `k` sits next to CJK text or an inline frame
+        // (Word: an equation), looking past neighbouring spaces.
+        // Half a cell next to a CJK character or an inline frame; next to
+        // full-width punctuation a space keeps its own width (measured:
+        // `表明， Deep` 3.5 pt, `达到 0.88` 6.3 pt).
+        // (`表明， Deep` 3.5 pt in Word 2013; Word 2003 mode makes that
+        // space half a cell too.)
+        let wide = |t: &Tok| {
+            t.kind == Kind::Cjk
+                || t.symbol
+                || t.frame
+                || (params.compat != 15 && matches!(t.kind, Kind::Close | Kind::Open))
+        };
+        // A space before full-width punctuation is half a cell in every mode
+        // (`ab cd ，龙` fits 3 pt less than with a normal space); after it,
+        // Word 2013 uses a normal space.
+        let wide_next = |t: &Tok| wide(t) || matches!(t.kind, Kind::Close | Kind::Open);
+        // A run of two or more spaces is half a cell each even between
+        // Latin words (measured: `ab  cd` and `dog.  Of` both grew by a
+        // whole space).
+        let double = (k > 0 && toks[k - 1].kind == Kind::Space && !toks[k - 1].user)
+            || (k + 1 < toks.len()
+                && toks[k + 1].kind == Kind::Space
+                && !toks[k + 1].user);
+        let space_ctx = double
+            || (0..k)
+                .rev()
+                .map(|i| &toks[i])
+                .find(|t| t.kind != Kind::Space || t.user)
+                .is_some_and(wide)
+            || (k + 1..toks.len())
+                .map(|i| &toks[i])
+                .find(|t| t.kind != Kind::Space || t.user)
+                .is_some_and(wide_next);
+        // With font kerning on, Word halves a full-width closer that is
+        // directly followed by another closer or an opener, and an opener
+        // followed by another opener (an opener before a closer keeps its
+        // width), except around a question mark, which Word never
+        // compresses.
+        let paired = params.kern
+            && !NEVER_COMPRESSED.contains(&toks[k].c)
+            && !toks[k].symbol
+            && toks.get(k + 1).is_some_and(|n| {
+                let ok = match toks[k].kind {
+                    Kind::Close => matches!(n.kind, Kind::Close | Kind::Open),
+                    Kind::Open => n.kind == Kind::Open,
+                    _ => false,
+                };
+                ok && !NEVER_COMPRESSED.contains(&n.c) && !n.symbol
+            });
+        let it = &mut toks[k];
+        let mut gap = Abs::zero();
+        // An East Asian symbol drawn full width occupies a cell, a
+        // half-width one (`•`) half a cell; Word 2013+ gives the Latin-1
+        // symbols (`×`, `°`, `·`, `±`) only the Latin glyph width (measured
+        // `××××年` at 12.23 pt per `×` under a 12.45 pt grid), Word 2003
+        // mode a whole cell.
+        let symbol_width = |it: &Tok| {
+            let latin1 = ('\u{00A1}'..='\u{00FF}').contains(&it.c);
+            if it.w < it.size * 0.9 || (params.compat == 15 && latin1) {
+                it.w + params.latin_add()
+            } else {
+                it.w + params.excess
+            }
+        };
+        match it.kind {
+            Kind::Cjk => {
+                it.nw = if it.symbol { symbol_width(it) } else { it.w + params.excess };
+            }
+            Kind::Close if it.symbol => {
+                // A symbol that may not start a line: it hangs like a
+                // closer. Only the middle dot has a blank to compress
+                // (measured `范围a·b`: 7.6 pt for the `b`, half a cell more
+                // than after `×`).
+                it.full = symbol_width(it);
+                it.nw = it.full;
+                it.spot = it.c == '·';
+            }
+            Kind::Close => {
+                it.full = it.w + params.excess;
+                it.paired = paired;
+                // Halved: half the cell (measured under a grid: half the
+                // size plus half the excess).
+                it.nw = if paired { it.full / 2.0 } else { it.full };
+                it.spot = !paired && !NEVER_COMPRESSED.contains(&it.c);
+            }
+            Kind::Open => {
+                it.full = it.w + params.excess;
+                it.paired = paired;
+                it.nw = if paired { it.full / 2.0 } else { it.full };
+                // An opener right after other full-width punctuation has no
+                // blank of its own to give up, unless that mark was halved
+                // (then the opener keeps its blank).
+                it.spot = !paired
+                    && !prev.as_ref().is_some_and(|t| {
+                        matches!(t.kind, Kind::Close | Kind::Open)
+                            && !t.paired
+                            && !t.symbol
+                    });
+            }
+            Kind::Latin => {
+                it.nw = if it.rigid {
+                    it.w
+                } else if LATINISH.contains(&it.c) && it.w >= it.size * 0.9 {
+                    // A full-width dash or tilde drawn by the CJK font
+                    // occupies a whole cell (measured: `——` at 12.4 each).
+                    it.w + params.excess
+                } else {
+                    it.w + params.latin_add() * it.glyph_count as f64
+                };
+                if it.hyph_after {
+                    it.hyph_w += params.latin_add();
+                }
+                if let Some(prev) = &prev
+                    && prev.kind == Kind::Cjk
+                    && !prev.symbol
+                    && !it.ea_head
+                    && it.head.is_some_and(is_alnum)
+                {
+                    gap = params.auto_at(prev.size);
+                }
+            }
+            Kind::Space => {
+                if it.user {
+                    it.nw = it.w;
+                } else {
+                    // A space next to CJK text (or an inline frame) is half
+                    // a cell wide and rigid, also in a run of spaces
+                    // (measured: 15 spaces in a title blank took 94 pt
+                    // under a 12.454 pt grid).
+                    if space_ctx {
+                        it.nw = (it.size + params.excess) / 2.0;
+                        it.rigid = true;
+                    } else {
+                        it.nw = it.w + params.latin_add();
+                    }
+                }
+            }
+        }
+        if let Some(prev) = &prev
+            && prev.kind == Kind::Latin
+            && it.kind == Kind::Cjk
+            && !it.symbol
+            && !prev.ea_tail
+            && prev.tail.is_some_and(is_alnum)
+        {
+            // Measured with mixed sizes: the spacing follows the size of the
+            // character before it, in both directions.
+            gap = params.auto_at(prev.size);
+        }
+        it.gap = gap;
+    }
+}
+
+/// A decided line.
+struct Decided {
+    /// The first and last token of the line.
+    first: usize,
+    last: usize,
+    /// The byte offset at which the line ends (the next line starts there).
+    end: usize,
+    breakpoint: Breakpoint,
+    /// The width the line is justified to.
+    target: Abs,
+    /// How much the natural width exceeds the capacity.
+    over: Abs,
+    /// Whether the line ends with hanging closing punctuation.
+    deep: bool,
+    /// Whether the line could not be broken legally and overflows.
+    forced: bool,
+    /// Whether the line is the last of the paragraph or ends at a forced
+    /// break.
+    ragged: bool,
+}
+
+/// The natural width of the tokens `first..=last` of a line.
+fn width_of(toks: &[Tok], first: usize, last: usize) -> Abs {
+    let mut w = Abs::zero();
+    for (k, it) in toks.iter().enumerate().take(last + 1).skip(first) {
+        // A space at a line edge is absorbed, except at the paragraph start
+        // (measured: four leading spaces in a 16 pt paragraph kept 33 pt).
+        if it.kind == Kind::Space && !it.user && ((k == first && first > 0) || k == last)
+        {
+            continue;
+        }
+        if it.kind == Kind::Space && it.weak && (k == first || k == last) {
+            continue;
+        }
+        w += if it.paired && k == last { it.full } else { it.nw };
+        // A line ending inside a hyphenated word carries the hyphen.
+        if k == last && it.hyph_after {
+            w += it.hyph_w;
+        }
+        if k > first {
+            w += it.gap;
+        }
+    }
+    w
+}
+
+/// Greedy line breaking with Word's rules.
+fn decide(
+    toks: &[Tok],
+    params: &Params,
+    measure: Abs,
+    breaks: &[usize],
+    emergency: &[usize],
+    mandatory: &[usize],
+    text: &str,
+) -> Vec<Decided> {
+    let text_len = text.len();
+    let n = toks.len();
+    let p = params.cell;
+    let compat = params.compat;
+    let half = p / 2.0;
+
+    // The first token of a line that is not spacing (an indent is a space
+    // token).
+    let text_start = |first: usize| -> usize {
+        let mut k = first;
+        while k + 1 < n && toks[k].kind == Kind::Space {
+            k += 1;
+        }
+        k
+    };
+
+    // The compression spots among the tokens `first..last` (exclusive). An
+    // opener at the start of the line has no blank to give up.
+    let spots = |first: usize, last: usize| -> usize {
+        let start = text_start(first);
+        (first..last)
+            .filter(|&k| toks[k].spot && !(toks[k].kind == Kind::Open && k == start))
+            .count()
+    };
+
+    // Word 2013 only compresses punctuation and hangs closers in justified
+    // paragraphs (measured: none of either with left alignment), while the
+    // Word 2003 layout does so regardless of the alignment.
+    let justify = params.justify || compat != 15;
+
+    // The grid excess of a cell (zero without a grid).
+    let ex = params.excess;
+    // The automatic CJK-Latin spacing at the paragraph's size.
+    let auto = params.auto_at(p - ex);
+
+    // The number of automatic spacings (gaps) among the tokens `first+1..=upto`.
+    let autos_in = |first: usize, upto: usize| -> usize {
+        (first + 1..=upto).filter(|&k| toks[k].gap > Abs::zero()).count()
+    };
+
+    // Word 2013+: the automatic spacings of a line lower the compression
+    // budget. Measured with indent sweeps at 12 pt: 0.85, 1.35, 1.7, 2.0 and
+    // 2.4 pt for 1, 2, 3, 4 and 6 gaps with two spots, half of that with one
+    // spot, and slowly less with more spots.
+    let penalty = |k: usize, gaps: f64| -> Abs {
+        if gaps <= 0.0 || k == 0 {
+            return Abs::zero();
+        }
+        let base = Abs::pt(1.35) * (libm::log(1.0 + gaps) / libm::log(3.0));
+        let factor = if k == 1 { 0.5 } else { (1.5 - 0.07 * k as f64).max(0.6) / 1.36 };
+        base * factor
+    };
+
+    // How much the automatic spacings of a line can shrink in total: half a
+    // gap for one gap, a whole gap for four or more (or two around a run
+    // right before the character).
+    let auto_cap = |gaps: usize, adjacent: bool| -> Abs {
+        if gaps == 0 && adjacent {
+            // Only the unit's own spacing (`•OH并`, ` ab cd龙`: the symbol
+            // or the space leaves the run without a spacing before it):
+            // half a point (measured between 0.45 and 0.55).
+            Abs::pt(0.5)
+        } else if gaps == 0 {
+            Abs::zero()
+        } else if adjacent {
+            auto
+        } else {
+            (auto / 2.0 + Abs::pt((gaps - 1) as f64)).min(auto)
+        }
+    };
+
+    // The start of the Latin run ending right before token `j`, if any.
+    let run_before = |first: usize, j: usize| -> Option<usize> {
+        if j == 0 || j <= first || !matches!(toks[j - 1].kind, Kind::Latin | Kind::Space)
+        {
+            return None;
+        }
+        let mut b = j - 1;
+        while b > first && matches!(toks[b - 1].kind, Kind::Latin | Kind::Space) {
+            b -= 1;
+        }
+        Some(b)
+    };
+
+    // The width of the unit `j..=m` as Word fits it: its tokens, the
+    // automatic spacing before it, and half a point more for a Latin run.
+    let unit_width = |first: usize, j: usize, m: usize| -> Abs {
+        let mut u = toks[j].gap;
+        for (k, it) in toks.iter().enumerate().take(m + 1).skip(j) {
+            u += if it.paired && k == m { it.full } else { it.nw };
+            if k > j {
+                u += it.gap;
+            }
+        }
+        // Spaces right before the unit belong to it (measured: a space and
+        // a digit after CJK text were squeezed like one cell).
+        let mut b = j;
+        while b > first + 1 && toks[b - 1].kind == Kind::Space {
+            b -= 1;
+            u += toks[b].nw;
+        }
+        // A Latin run after CJK text gets a little more (measured 0.2-0.7
+        // pt) unless closers follow it.
+        if toks[j].kind == Kind::Latin
+            && toks[j].glyphs
+            && toks[j].gap > Abs::zero()
+            && m == j
+            && toks[j].tail_hang.is_zero()
+        {
+            u += Abs::pt(0.4);
+        }
+        u
+    };
+
+    // How much a space may shrink when the line is squeezed: a quarter of
+    // its width, nothing for a space in a run of spaces, and nothing for
+    // a half-cell space right before the CJK unit being fitted (measured:
+    // `闰余 ab cd龙` 1.5 pt above `ab cd龙`, `ab cd 龙` 1.5 below it,
+    // `ab  cd龙` and `ab   cd龙` no more than `abcd龙`).
+    let space_give = |k: usize| -> Abs {
+        let t = &toks[k];
+        if t.kind != Kind::Space || t.user {
+            return Abs::zero();
+        }
+        if t.rigid {
+            // A half-cell space (next to CJK text) never shrinks (`out/
+            // sweep-*-is`/`ib`: one to four of them give a Latin unit
+            // nothing after any number of spots).
+            return Abs::zero();
+        }
+        let in_run = (k > 0 && toks[k - 1].kind == Kind::Space)
+            || (k + 1 < n && toks[k + 1].kind == Kind::Space);
+        if in_run {
+            return Abs::zero();
+        }
+        // A space right after full-width punctuation can vanish entirely
+        // (a thesis line `评估表明， DeepIntegration` in Word 2013: the
+        // comma and period halved, the space squeezed to nothing).
+        let after_punct = k > 0
+            && matches!(toks[k - 1].kind, Kind::Close | Kind::Open)
+            && !toks[k - 1].symbol;
+        if after_punct { t.nw } else { t.nw * 0.25 }
+    };
+
+    // ------------------------------------------------------------------
+    // Word 2013+: how far the unit `j..=m` (openers, a character or Latin
+    // run at `core`, closers) may overflow the measure.
+    //
+    // The model, in one sentence: a unit fits when its overflow is at most
+    // its *budget*; the budget comes from the k punctuation spots before it
+    // (half a cell each), the g automatic CJK-Latin spacings on the line
+    // (a pool that helps a little at k = 0 and costs at k ≥ 1), the unit's
+    // own width u (it can never be squeezed by more than about k/(k+1) of
+    // itself), and a hanging closer (a whole cell). Three shapes of unit are
+    // measured directly with 0.1 pt indent sweeps (`out/sweep-*-ik`, `ig`,
+    // `ix`, `il`, `is`, `ib`; tables below); everything else — units with
+    // closers or openers, Latin runs after spaces, symbols, table cells —
+    // still uses the older fitted form, which the measured shapes agree
+    // with to a few tenths of a point where they overlap.
+    //
+    //   CjkChar     bare CJK character:    k = 0: pool_C(g)
+    //                                       k ≥ 1: min(half·k, u·k/(k+1) + E(k) − D(g)·share(k))
+    //   GluedLatin  Latin run glued to CJK, no closers: k ≥ 1:
+    //                 min(half·k + half a spacing per spacing on the line,
+    //                     ((1.031u − 2.85)·k/(k+1) + 1.9)·(1 − 0.136·ln(1+g)))
+    //   General     min(half·k + hang + spacing part [+ space shrink],
