+                    have = true;
+                    deep = false;
+                }
+            }
+            break;
+        }
+        if !have {
+            last = first_unit.unwrap_or(first);
+        }
+
+        // A line may not end with a space, an opener or Latin opening
+        // punctuation, nor where no break is legal.
+        // An emergency break inside a long run is legal only when the run
+        // starts the line.
+        let legal = |k: usize| {
+            if may_hyphenate && syllable_ok(k) && k + 1 < n {
+                let s = word_start(first, k);
+                // Openers before the word move down with it.
+                let mut before = s;
+                while before > first && toks[before - 1].kind == Kind::Open {
+                    before -= 1;
+                }
+                while before > first && toks[before - 1].kind == Kind::Space {
+                    before -= 1;
+                }
+                if before == first {
+                    // The word starts the line: it may be hyphenated.
+                    return true;
+                }
+                // (The gap is measured with the line's punctuation spots
+                // compressed — `out/hy-e15gc`: with two commas on the line
+                // `in-` still hangs on where the natural gap is 14 pt — but
+                // not with its spaces squeezed.)
+                let gap = cap_for(k) - width_of(toks, first, before - 1)
+                    + half * spots(first, before) as f64;
+                if std::env::var_os("MSWORD_DEBUG").is_some() {
+                    eprintln!(
+                        "  hyzone k={k} before={before} natural_gap={:.2} spots={} gap={:.2} legal={}",
+                        (cap_for(k) - width_of(toks, first, before - 1)).to_pt(),
+                        spots(first, before),
+                        gap.to_pt(),
+                        gap > zone + EPS
+                    );
+                }
+                return gap > zone + EPS;
+            }
+            let Some(off) = break_after(k) else { return false };
+            if off < text_len && emergency.binary_search(&off).is_ok() {
+                let mut b = k;
+                while b > first
+                    && toks[b - 1].kind == Kind::Latin
+                    && toks[b - 1].glyphs
+                    && toks[b - 1].range.end == toks[b].range.start
+                {
+                    b -= 1;
+                }
+                return b == text_start(first);
+            }
+            true
+        };
+        // (A Latin run ending in `“` or `(` may not end a line either, even
+        // with a space after it: a German thesis breaks before `Beginners“`.)
+        let bad_end = |k: usize| {
+            let t = &toks[k];
+            (t.kind == Kind::Space && !t.user)
+                || t.kind == Kind::Open
+                || (t.kind == Kind::Latin
+                    && t.tail.is_some_and(|c| {
+                        ASCII_OPEN.contains(&c) || NO_LINE_END.contains(&c)
+                    }))
+        };
+        if forced_end.is_none() {
+            while last > first && (bad_end(last) || !legal(last)) {
+                last -= 1;
+            }
+        }
+        let mut forced = false;
+        if forced_end.is_none() && !legal(last) {
+            while last + 1 < n && !legal(last) {
+                last += 1;
+            }
+            forced = true;
+        }
+        // A line ending inside a hyphenated word (a syllable token that may
+        // end a line) carries a hyphen.
+        let hyphen =
+            toks[last].hyph_after && last + 1 < n && may_hyphenate && syllable_ok(last);
+        // Trailing spaces at the end of the paragraph join the last line.
+        if forced_end.is_none() && !hyphen && last + 1 < n {
+            let mut k = last + 1;
+            while k < n && toks[k].kind == Kind::Space {
+                k += 1;
+            }
+            if k >= n {
+                last = n - 1;
+            }
+        }
