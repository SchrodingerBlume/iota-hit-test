+                }
+                j = m + 1;
+                continue;
+            }
+            // The word does not fit whole: Word's automatic hyphenation
+            // takes the longest syllable that fits — naturally (the old
+            // modes want `old_hyphen_room` to spare), or squeezed in when
+            // that costs less than twice the stretch of the shorter
+            // alternative, the syllable before it or the line without the
+            // word (measured `out/hy-e15`: `characteris-` gives way to
+            // `character-` at 3 pt of squeeze against 5 pt of stretch and
+            // keeps at 2.5 against 5.5; `char-` squeezes 8.5 against a 33 pt
+            // gap). The line ends there.
+            // (Also a word after openers, `（Den-sity`.)
+            let wj = {
+                let mut q = j;
+                while q < n && toks[q].kind == Kind::Open {
+                    q += 1;
+                }
+                q
+            };
+            // The first hyphenation point of the run: a URL's first word
+            // may sit behind `http://` (`数据集http://bio-` in a thesis).
+            let ws = {
+                let mut q = wj;
+                while q + 1 < n
+                    && toks[q].kind == Kind::Latin
+                    && toks[q].glyphs
+                    && !toks[q].hyph_after
+                    && toks[q + 1].kind == Kind::Latin
+                    && toks[q].range.end == toks[q + 1].range.start
+                {
+                    q += 1;
+                }
+                q
+            };
+            if ws < n
+                && toks[ws].kind == Kind::Latin
+                && toks[ws].hyph_after
+                && may_hyphenate
+                && syllable_ok(ws)
+            {
+                let mut cands = Vec::new();
+                let mut t = ws;
+                while t + 1 < n && toks[t].kind == Kind::Latin && toks[t].hyph_after {
+                    cands.push(t);
+                    t += 1;
+                }
+                let mut before = j;
+                while before > first && toks[before - 1].kind == Kind::Space {
+                    before -= 1;
+                }
+                let mut taken = None;
+                for &t in cands.iter().rev() {
+                    let need_t = width_of(toks, first, t) + old_hyphen_room(t) - capacity;
+                    if need_t <= EPS {
+                        taken = Some(t);
+                        break;
+                    }
+                    if compat != 15 {
+                        continue;
+                    }
+                    // The punctuation spots give the syllable what they
+                    // would give the whole word (`out/hy-x18g`: `（Den-`
+                    // takes the three half cells its own width would cap
+                    // at 13.5 pt); the spaces give what they give the
+                    // syllable.
+                    let mut budget_t = if spots(first, wj) > 0 {
+                        syllable_budget(first, j, wj, t)
+                    } else {
+                        unit_budget(first, wj, wj, t, t)
+                    };
+                    if spots(first, wj) == 0 {
+                        budget_t +=
+                            space_shrink(first, wj, wj, t, t, spots(first, wj), budget_t);
+                    }
+                    let stretch = if t > wj {
+                        capacity - width_of(toks, first, t - 1)
+                    } else if before == first {
+                        capacity
+                    } else {
+                        capacity - width_of(toks, first, before - 1)
+                    };
+                    // Squeeze taken from punctuation spots costs a third of
+                    // its width, squeeze taken from spaces twice its width
+                    // (`out/hy-e15gc`, two commas on the line: a syllable
+                    // gives way to the shorter one when the stretch that
+                    // would leave drops below a third of its squeeze,
+                    // `characteris-` 6.5 against 2, `character-` 10 against
+                    // 3.5, `funda-` 9 against 3).
+                    let from_spots = need_t.min(half * spots(first, j) as f64);
+                    let cost = if spots(first, wj) > 0 {
+                        // Shared out over the spots (`out/hy-x21`: `infor-`
+                        // over two commas gives way to `in-` when its 5.2 pt
+                        // per spot exceeds the 4.3 pt `in-` would leave;
+                        // `connec-` over six `、` takes 2.5 pt each against
+                        // 2.2 pt in a thesis).
+                        from_spots / (spots(first, wj) as f64 * 1.15).max(3.0)
+                            + (need_t - from_spots) * 2.0
+                    } else {
+                        from_spots / 3.0 + (need_t - from_spots) * 2.0
+                    };
+                    if std::env::var_os("MSWORD_DEBUG").is_some() {
+                        eprintln!(
+                            "  hysyl t={t} need={:.2} budget={:.2} cost={:.2} stretch={:.2} k={}",
+                            need_t.to_pt(),
+                            budget_t.to_pt(),
+                            cost.to_pt(),
+                            stretch.to_pt(),
+                            spots(first, wj)
+                        );
+                    }
+                    if need_t <= budget_t + EPS && cost <= stretch + EPS {
+                        taken = Some(t);
+                        break;
+                    }
+                }
+                if let Some(t) = taken {
