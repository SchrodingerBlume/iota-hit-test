+                        glyph.x_advance += Em::from_abs(extra, size);
+                    }
+                    g = e;
+                }
+                Kind::Space => {
+                    let glyph = &mut glyphs[g];
+                    glyph.adjustability = Adjustability::default();
+                    glyph.is_justifiable = false;
+                    let target = if !it.user && ((k == first && first > 0) || k == last) {
