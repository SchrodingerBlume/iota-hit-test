+            config.adjust_right_indent.into_value(),
+        );
+        dict.insert("kern".into(), config.kern.into_value());
+        dict.insert("balance-widths".into(), config.balance_widths.into_value());
+        dict.insert("cell".into(), config.cell.into_value());
+        dict.insert(
+            "consecutive-hyphens".into(),
+            (config.consecutive_hyphens as i64).into_value(),
+        );
+        dict.insert("hyphenate-caps".into(), config.hyphenate_caps.into_value());
+        dict.insert("compress".into(), config.compress.into_value());
