+    let pool = |g: usize, latin: bool| -> Abs {
+        const C: [f64; 9] = [0.0, 1.55, 2.75, 3.15, 3.45, 3.55, 3.75, 3.75, 3.75];
+        const L: [f64; 9] = [0.0, 1.6, 3.0, 3.2, 3.3, 3.3, 3.3, 3.4, 3.4];
