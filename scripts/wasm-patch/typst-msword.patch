+                if it.rigid {
+                    halves.push(k);
+                } else {
+                    spaces.push(k);
+                }
+            }
+            if matches!(it.kind, Kind::Cjk | Kind::Close | Kind::Open) && k < last {
+                cjkgaps.push(k);
+            }
+        }
